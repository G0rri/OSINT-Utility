# Configuración de claves de API de terceros para OSINT Utility
# Renombra este archivo a ".env" y coloca tus claves de API reales.
#
# Todas son OPCIONALES: sin ellas la aplicación arranca igualmente y los
# módulos afectados quedan en estado de aviso (🟠/🔴) sin bloquear el resto.

# VirusTotal API Key (reputación de IPs y dominios)
# Obtén la tuya en: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=tu_api_key_aqui

# --- Enriquecimiento opcional de PhoneInfoga ---
# Numverify (validación y operadora de números de teléfono)
# https://numverify.com/
NUMVERIFY_API_KEY=tu_api_key_aqui

# APILayer / Google Search de PhoneInfoga
# https://apilayer.com/
APILAYER_KEY=tu_api_key_aqui
